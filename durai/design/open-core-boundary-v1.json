{
  "format": "durai-open-core-boundary/v1",
  "date": "2026-11-24",
  "plan": "plan_durai_open_core_finish_2026-11-24.md section 3",
  "classes": {
    "OPEN": "Published under Apache-2.0 in the public shell repository.",
    "FREE_PACK": "Published in the free starter pack under the Pack License.",
    "PAID_PACK": "Sold as a signed pack. Never in the public repository.",
    "PAID_FEED": "Sold as a signed update feed. Never in the public repository.",
    "PRIVATE": "Kept in the private repository. Not published and not sold.",
    "NEVER": "Never leaves this computer. Holds or sets keys."
  },
  "order_note": "The first matching rule wins. A file with no match is unclassified and fails the scan.",
  "rules": [
    {"glob": "durai/set-*-key.cmd", "class": "NEVER", "reason": "Key setter scripts."},
    {"glob": "durai/private/**", "class": "NEVER", "reason": "Local keys and settings."},
    {"glob": "durai/traces/**", "class": "PRIVATE", "reason": "Raw model traces can hold prompts."},
    {"glob": "durai/worker-evidence/**", "class": "PRIVATE", "reason": "Raw worker evidence."},
    {"glob": "durai/review-candidates/**", "class": "PRIVATE", "reason": "Candidate reviews not yet approved."},
    {"glob": "plans/**", "class": "PRIVATE", "reason": "Strategy and planning notes. The owner may open single files."},

    {"glob": "durai/receipts/blind-build-*", "class": "OPEN", "reason": "Public benchmark evidence."},
    {"glob": "durai/receipts/build-review-*", "class": "OPEN", "reason": "Public benchmark evidence."},
    {"glob": "durai/receipts/product-review-*", "class": "OPEN", "reason": "Public benchmark evidence."},
    {"glob": "durai/receipts/model-comparison-*", "class": "OPEN", "reason": "Public benchmark evidence (marked as simulation)."},
    {"glob": "durai/receipts/**", "class": "PRIVATE", "reason": "Qualification receipts hold model output."},

    {"glob": "durai/templates/trading-demo/**", "class": "FREE_PACK", "reason": "Starter demo."},
    {"glob": "durai/templates/position-app/**", "class": "FREE_PACK", "reason": "Starter demo."},
    {"glob": "durai/templates/**", "class": "PAID_PACK", "reason": "Task fixture corpus."},

    {"glob": "durai/design/engineering-philosophy-v15.json", "class": "FREE_PACK", "reason": "Latest generic ontology."},
    {"glob": "durai/design/architecture-defaults-v1.json", "class": "FREE_PACK", "reason": "Starter defaults."},
    {"glob": "durai/design/ontology-store-layout-v1.json", "class": "OPEN", "reason": "Store layout is part of the pack format."},
    {"glob": "durai/design/engineering-philosophy-v*.json", "class": "PAID_PACK", "reason": "Ontology revision history."},
    {"glob": "durai/design/transaction-blueprints-v1.json", "class": "PAID_PACK", "reason": "Blueprint catalog."},
    {"glob": "durai/design/prompt/compare/**", "class": "OPEN", "reason": "Compare-request template. Shell data, no paid content."},
    {"glob": "durai/design/prompt/themes/**", "class": "OPEN", "reason": "UI theme catalog. Shell data, no paid content."},
    {"glob": "durai/design/prompt-lessons/**", "class": "PAID_FEED", "reason": "Lessons pass a human gate and update often."},
    {"glob": "durai/design/prompt/**", "class": "PAID_PACK", "reason": "Prompt catalog data."},
    {"glob": "durai/design/samples/**", "class": "PAID_PACK", "reason": "Sample requests. Two starter samples may move to the free pack."},
    {"glob": "durai/design/manifests/**", "class": "OPEN", "reason": "Run manifests."},
    {"glob": "durai/design/open-core-boundary-*.json", "class": "OPEN", "reason": "This file."},
    {"glob": "durai/design/trusted-publishers-v1.json", "class": "OPEN", "reason": "Public keys only. Verifiers need them."},
    {"glob": "durai/design/**", "class": "PRIVATE", "reason": "Unreviewed design data. Review before any class change."},

    {"glob": "durai/blueprints/**", "class": "PAID_PACK", "reason": "Qualified transaction blueprints."},
    {"glob": "durai/qualification/**", "class": "PAID_PACK", "reason": "Qualification fixtures and goals."},
    {"glob": "durai/docs/*-blueprint.md", "class": "PAID_PACK", "reason": "Blueprint documents."},
    {"glob": "durai/docs/*-qualification.md", "class": "PAID_PACK", "reason": "Qualification documents."},

    {"glob": "durai/durai/**", "class": "OPEN", "reason": "Shell modules."},
    {"glob": "durai/tools/**", "class": "OPEN", "reason": "Shell tools."},
    {"glob": "durai/tests/**", "class": "OPEN", "reason": "Shell tests."},
    {"glob": "durai/migrations/**", "class": "OPEN", "reason": "Store schema."},
    {"glob": "durai/contracts/**", "class": "OPEN", "reason": "Contract schemas."},
    {"glob": "durai/docker/**", "class": "OPEN", "reason": "Evaluation images."},
    {"glob": "durai/databricks/**", "class": "OPEN", "reason": "Databricks deployment bundle and Lakebase parity checks."},
    {"glob": "durai/apps/**", "class": "OPEN", "reason": "Reference apps."},
    {"glob": "durai/docs/**", "class": "OPEN", "reason": "Documentation."},
    {"glob": "durai/*.lock.json", "class": "OPEN", "reason": "Image locks."},
    {"glob": "durai/requirements.*", "class": "OPEN", "reason": "Dependencies."},
    {"glob": "durai/README.md", "class": "OPEN", "reason": "Readme."},
    {"glob": "durai/local.py", "class": "OPEN", "reason": "Local launcher."},
    {"glob": "durai/manage.py", "class": "OPEN", "reason": "Management command."},
    {"glob": "durai/.gitignore", "class": "OPEN", "reason": "Ignore list."},
    {"glob": "packs/starter/**", "class": "FREE_PACK", "reason": "Starter pack folder of the public export."},
    {"glob": "durai/packs/durai.starter-*.json", "class": "FREE_PACK", "reason": "Signed free starter pack."},
    {"glob": "durai/packs/durai.egress-starter-*.json", "class": "FREE_PACK", "reason": "Signed starter egress record."},
    {"glob": "durai/packs/test_public_key.hex", "class": "FREE_PACK", "reason": "Test public key for starter pack verification."},
    {"glob": "durai/packs/durai.blueprints.*.json", "class": "PAID_PACK", "reason": "Signed paid blueprint pack."},
    {"glob": "durai/examples/**", "class": "OPEN", "reason": "Example domain files."},
    {"glob": ".gitattributes", "class": "OPEN", "reason": "Line ending rules."},
    {"glob": ".github/**", "class": "OPEN", "reason": "Repository readme and workflows."},
    {"glob": "AGENTS.md", "class": "OPEN", "reason": "Project instructions."},
    {"glob": "LICENSE", "class": "OPEN", "reason": "License."},
    {"glob": "NOTICE", "class": "OPEN", "reason": "Notice."},
    {"glob": "TRADEMARKS.md", "class": "OPEN", "reason": "Trademark policy."},
    {"glob": "CONTRIBUTING.md", "class": "OPEN", "reason": "Contribution rules."},
    {"glob": "PACK_LICENSE.md", "class": "OPEN", "reason": "Pack license draft."},
    {"glob": "SECURITY.md", "class": "OPEN", "reason": "Security policy and reporting."}
  ],
  "hidden_goal_name_patterns": ["*hidden*goal*", "*goals-hidden*", "*goal_hidden*"]
}
